global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    environment: "recrute"
    project: "winderp"

# Alertmanager configuration (optionnel)
alerting:
  alertmanagers:
    - static_configs:
        - targets: []
          # - alertmanager:9093

# Règles d'alerte
rule_files:
# - "alerts.yml"

# Configuration des cibles à scraper
scrape_configs:
  # Prometheus lui-même
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']
        labels:
          service: prometheus
          environment: monitoring

  # Kubernetes pods avec annotations
  - job_name: 'kubernetes-pods'
    kubernetes_sd_configs:
      - role: pod
        namespaces:
          names:
            - recrute
    relabel_configs:
      # Ne scraper que les pods avec annotation prometheus.io/scrape=true
      - source_labels: [__meta_kubernetes_pod_annotation_prometheus_io_scrape]
        action: keep
        regex: true

      # Récupérer le chemin des métriques
      - source_labels: [__meta_kubernetes_pod_annotation_prometheus_io_path]
        action: replace
        target_label: __metrics_path__
        regex: (.+)
        replacement: $1

      # Récupérer le port des métriques
      - source_labels: [__address__, __meta_kubernetes_pod_annotation_prometheus_io_port]
        action: replace
        regex: ([^:]+)(?::\d+)?;(\d+)
        replacement: $1:$2
        target_label: __address__

      # Ajouter des labels pour faciliter la recherche
      - source_labels: [__meta_kubernetes_pod_label_app]
        action: replace
        target_label: app

      - source_labels: [__meta_kubernetes_pod_name]
        action: replace
        target_label: pod

      - source_labels: [__meta_kubernetes_namespace]
        action: replace
        target_label: namespace

      - source_labels: [__meta_kubernetes_pod_container_name]
        action: replace
        target_label: container

  # Spring Boot Actuator metrics pour tous les services
  - job_name: 'spring-boot-apps'
    metrics_path: '/actuator/prometheus'
    scrape_interval: 30s
    static_configs:
      - targets:
          - 'api-gateway.recrute.svc.cluster.local:8080'
          - 'authentication.recrute.svc.cluster.local:8081'
          - 'candidate-service.recrute.svc.cluster.local:8082'
          - 'interview-service.recrute.svc.cluster.local:8083'
          - 'dashboard-service.recrute.svc.cluster.local:8084'
          - 'notificationservice.recrute.svc.cluster.local:8085'
          - 'eureka-server.recrute.svc.cluster.local:8761'
        labels:
          job: spring-boot
          tier: microservice

  # PostgreSQL metrics (si node exporter est installé)
  - job_name: 'postgresql'
    static_configs:
      - targets: ['postgres.recrute.svc.cluster.local:9187']
        labels:
          service: postgresql
          database: recrutedb

  # Redis metrics
  - job_name: 'redis'
    static_configs:
      - targets: ['redis.recrute.svc.cluster.local:9121']
        labels:
          service: redis
          cache: recrute-cache

  # Node metrics des hôtes Kubernetes
  - job_name: 'kubernetes-nodes'
    scheme: https
    tls_config:
      ca_file: /var/run/secrets/kubernetes.io/serviceaccount/ca.crt
    bearer_token_file: /var/run/secrets/kubernetes.io/serviceaccount/token
    kubernetes_sd_configs:
      - role: node
    relabel_configs:
      - action: labelmap
        regex: __meta_kubernetes_node_label_(.+)
      - target_label: __address__
        replacement: kubernetes.default.svc:443
      - source_labels: [__meta_kubernetes_node_name]
        regex: (.+)
        target_label: __metrics_path__
        replacement: /api/v1/nodes/$1/proxy/metrics

  # Docker containers metrics (si vous utilisez Docker directement)
  - job_name: 'docker-containers'
    static_configs:
      - targets: ['localhost:9323']
        labels:
          service: docker
          environment: local